{
  "name": "participant-dedup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Container-bound Google Apps Script for fuzzy participant deduplication",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build/esbuild.mjs",
    "api:dev": "tsx services/api/src/server.ts",
    "api:start": "tsx services/api/src/server.ts",
    "push": "pnpm build && clasp -P .clasp.json push -f",
    "addon:push": "pnpm build && clasp -P .clasp.addon.json push -f",
    "addon:version": "clasp -P .clasp.addon.json version",
    "addon:deploy": "clasp -P .clasp.addon.json deploy",
    "fixture": "tsx tools/generateFixture.ts",
    "dogfood": "tsx tools/dogfoodReport.ts",
    "sheet-dogfood": "tsx tools/sheetDogfood.ts",
    "dedup": "tsx tools/dedupCli.ts",
    "dedup:compile": "bash tools/compile-dedup.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.0.11",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "hono": "^4.12.31",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/exceljs": "^1.3.2",
    "@types/google-apps-script": "^1.0.100",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
